// BS-S-017: Find Second Maximum
// Returns the second distinct maximum, or "none" if fewer than 2 distinct values.
// Lang4LLM lacks Option types; we use a string-returning helper for output.

fn find_second_max_str(numbers: [int]) -> string {
    let n: int = len(numbers);
    if n == 0 {
        return "none";
    };
    // Find first max
    let mut max1: int = numbers[0];
    for i in range(1, n) {
        if numbers[i] > max1 {
            max1 = numbers[i];
        };
    }
    // Find second distinct max: largest value strictly less than max1
    let mut found_second: bool = false;
    let mut max2: int = 0;
    for i in range(0, n) {
        if numbers[i] < max1 {
            if found_second == false {
                max2 = numbers[i];
                found_second = true;
            } else {
                if numbers[i] > max2 {
                    max2 = numbers[i];
                };
            };
        };
    }
    if found_second == false {
        return "none";
    };
    return to_string(max2);
}

fn main() -> unit {
    let a: [int] = [3, 1, 4, 1, 5, 9, 2, 6];
    print("find_second_max([3,1,4,1,5,9,2,6]) = " + find_second_max_str(a));

    let b: [int] = [5, 5, 5];
    print("find_second_max([5,5,5]) = " + find_second_max_str(b));

    let c: [int] = [4, 4, 7, 7];
    print("find_second_max([4,4,7,7]) = " + find_second_max_str(c));

    let d: [int] = [10];
    print("find_second_max([10]) = " + find_second_max_str(d));

    let e: [int] = [-1, -5, -3];
    print("find_second_max([-1,-5,-3]) = " + find_second_max_str(e));

    let f: [int] = [1, 2];
    print("find_second_max([1,2]) = " + find_second_max_str(f));
}
