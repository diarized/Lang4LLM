fn find_maximum(numbers: [int]) -> int {
    let mut max_val: int = numbers[0];
    for i in range(1, len(numbers)) {
        if numbers[i] > max_val {
            max_val = numbers[i];
        };
    }
    return max_val;
}

fn main() -> unit {
    let a: [int] = [3, 7, 2, 9, 1];
    print("find_maximum([3,7,2,9,1]) = " + to_string(find_maximum(a)));

    let b: [int] = [-5, -2, -8, -1];
    print("find_maximum([-5,-2,-8,-1]) = " + to_string(find_maximum(b)));

    let c: [int] = [-3, 5, -1, 2];
    print("find_maximum([-3,5,-1,2]) = " + to_string(find_maximum(c)));

    let d: [int] = [42];
    print("find_maximum([42]) = " + to_string(find_maximum(d)));

    let e: [int] = [7, 7, 7, 7];
    print("find_maximum([7,7,7,7]) = " + to_string(find_maximum(e)));

    let f: [int] = [10, 1, 100, 50];
    print("find_maximum([10,1,100,50]) = " + to_string(find_maximum(f)));
}
