// BS-S-029: Check Prime Number
// Determine whether a positive integer is prime (O(sqrt(n)) approach).

fn is_prime(number: int) -> bool {
    if number < 2 {
        return false;
    };
    if number == 2 {
        return true;
    };
    if number % 2 == 0 {
        return false;
    };
    let limit: int = as_int(sqrt(as_float(number)));
    let mut i: int = 3;
    let mut found_factor: bool = false;
    for j in range(0, 1000000) {
        if i <= limit {
            if number % i == 0 {
                found_factor = true;
            };
            i = i + 2;
        };
    }
    return found_factor == false;
}

fn main() -> unit {
    print("is_prime(7) = " + to_string(is_prime(7)));
    print("is_prime(9) = " + to_string(is_prime(9)));
    print("is_prime(1) = " + to_string(is_prime(1)));
    print("is_prime(2) = " + to_string(is_prime(2)));
    print("is_prime(4) = " + to_string(is_prime(4)));
    print("is_prime(97) = " + to_string(is_prime(97)));
    print("is_prime(100) = " + to_string(is_prime(100)));
    print("is_prime(3) = " + to_string(is_prime(3)));
}
