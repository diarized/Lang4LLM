{
  "spec": "BS-S-007",
  "title": "Find Minimum in List",
  "tier": "simple",
  "lang4llm_compatible": true,
  "expected": [
    "find_minimum([3,7,2,9,1]) = 1",
    "find_minimum([-5,-2,-8,-1]) = -8",
