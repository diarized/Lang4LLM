{
  "spec": "BS-S-008",
  "title": "Remove Duplicates from List",
  "tier": "simple",
  "lang4llm_compatible": true,
  "expected": [
    "remove_duplicates([1,2,2,3,1,4]) = [1, 2, 3, 4]",
    "remove_duplicates([5,3,8,1]) = [5, 3, 8, 1]",
    "remove_duplicates([7,7,7,7]) = [7]",
    "remove_duplicates([]) = []",
    "remove_duplicates([-1,-2,-1,0,-2]) = [-1, -2, 0]"
  ]
}
