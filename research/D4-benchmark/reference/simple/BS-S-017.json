{
  "spec": "BS-S-017",
  "title": "Find Second Maximum",
  "tier": "simple",
  "lang4llm_compatible": true,
  "notes": "Lang4LLM lacks Option types; absent second max returns 'none' string via helper function",
  "expected": [
    "find_second_max([3,1,4,1,5,9,2,6]) = 6",
    "find_second_max([5,5,5]) = none",
    "find_second_max([4,4,7,7]) = 4",
    "find_second_max([10]) = none",
    "find_second_max([-1,-5,-3]) = -3",
    "find_second_max([1,2]) = 1"
  ]
}
