fn find_minimum(numbers: [int]) -> int {
    let mut min_val: int = numbers[0];
    for i in range(1, len(numbers)) {
        if numbers[i] < min_val {
            min_val = numbers[i];
        };
    }
    return min_val;
}

fn main() -> unit {
    let a: [int] = [3, 7, 2, 9, 1];
    print("find_minimum([3,7,2,9,1]) = " + to_string(find_minimum(a)));

    let b: [int] = [-5, -2, -8, -1];
    print("find_minimum([-5,-2,-8,-1]) = " + to_string(find_minimum(b)));

    let c: [int] = [-3, 5, -1, 2];
    print("find_minimum([-3,5,-1,2]) = " + to_string(find_minimum(c)));

    let d: [int] = [42];
    print("find_minimum([42]) = " + to_string(find_minimum(d)));

    let e: [int] = [4, 4, 4, 4];
    print("find_minimum([4,4,4,4]) = " + to_string(find_minimum(e)));

    let f: [int] = [10, 1, 100, 50];
    print("find_minimum([10,1,100,50]) = " + to_string(find_minimum(f)));
}
