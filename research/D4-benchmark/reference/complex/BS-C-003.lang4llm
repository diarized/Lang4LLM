fn is_digit_char(c: string) -> bool {
    return c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
        or c == "5" or c == "6" or c == "7" or c == "8" or c == "9";
}

fn char_to_digit(c: string) -> int {
    if c == "0" { return 0; };
    if c == "1" { return 1; };
    if c == "2" { return 2; };
    if c == "3" { return 3; };
    if c == "4" { return 4; };
    if c == "5" { return 5; };
    if c == "6" { return 6; };
    if c == "7" { return 7; };
    if c == "8" { return 8; };
    return 9;
}

fn str_to_float(s: string) -> float {
    let chs: [string] = chars(s);
    let mut int_part: float = 0.0;
    let mut frac_part: float = 0.0;
    let mut frac_div: float = 1.0;
    let mut in_frac: bool = false;
    let mut i: int = 0;
    while i < len(chs) {
        if chs[i] == "." {
            in_frac = true;
        } else {
            if in_frac {
                frac_div = frac_div * 10.0;
                frac_part = frac_part + as_float(char_to_digit(chs[i])) / frac_div;
            } else {
                int_part = int_part * 10.0 + as_float(char_to_digit(chs[i]));
            };
        };
        i = i + 1;
    }
    return int_part + frac_part;
}

fn prec(op: string) -> int {
    if op == "+" or op == "-" { return 1; };
    if op == "*" or op == "/" { return 2; };
    return 0;
}

fn apply_op(a: float, b: float, op: string) -> float {
    if op == "+" { return a + b; };
    if op == "-" { return a - b; };
    if op == "*" { return a * b; };
    return a / b;
}

fn eval_expr(expr: string) -> float {
    let chs: [string] = chars(expr);
    let mut out_stack: [float] = [];
    let mut op_stack: [string] = [];
    let mut i: int = 0;
    let mut prev_was_num: bool = false;
    while i < len(chs) {
        let c: string = chs[i];
        if c == " " or c == "\t" {
            i = i + 1;
        } else {
            if is_digit_char(c) {
                let mut num_str: string = "";
                while i < len(chs) and (is_digit_char(chs[i]) or chs[i] == ".") {
                    num_str = num_str + to_string(chs[i]);
                    i = i + 1;
                }
                push(out_stack, str_to_float(num_str));
                prev_was_num = true;
            } else {
                if c == "(" {
                    push(op_stack, "(");
                    prev_was_num = false;
                    i = i + 1;
                } else {
                    if c == ")" {
                        while len(op_stack) > 0 and op_stack[len(op_stack) - 1] != "(" {
                            let top_op: string = pop(op_stack);
                            let b: float = pop(out_stack);
                            let a: float = pop(out_stack);
                            push(out_stack, apply_op(a, b, top_op));
                        }
                        if len(op_stack) > 0 {
                            pop(op_stack);
                        };
                        prev_was_num = true;
                        i = i + 1;
                    } else {
                        if c == "-" and not prev_was_num {
                            push(out_stack, 0.0);
                        };
                        while len(op_stack) > 0 and op_stack[len(op_stack) - 1] != "(" and prec(op_stack[len(op_stack) - 1]) >= prec(c) {
                            let top_op2: string = pop(op_stack);
                            let b2: float = pop(out_stack);
                            let a2: float = pop(out_stack);
                            push(out_stack, apply_op(a2, b2, top_op2));
                        }
                        push(op_stack, c);
                        prev_was_num = false;
                        i = i + 1;
                    };
                };
            };
        };
    }
    while len(op_stack) > 0 {
        let top_op3: string = pop(op_stack);
        let b3: float = pop(out_stack);
        let a3: float = pop(out_stack);
        push(out_stack, apply_op(a3, b3, top_op3));
    }
    return out_stack[0];
}

fn main() -> unit {
    print("3 + 5 = " + to_string(eval_expr("3 + 5")));
    print("2 + 3 * 4 = " + to_string(eval_expr("2 + 3 * 4")));
    print("(2 + 3) * 4 = " + to_string(eval_expr("(2 + 3) * 4")));
    print("10 / 2 + 3 = " + to_string(eval_expr("10 / 2 + 3")));
    print("2 * (3 + 4) - 10 / 5 = " + to_string(eval_expr("2 * (3 + 4) - 10 / 5")));
    print("-5 + 3 = " + to_string(eval_expr("-5 + 3")));
    print("10 - 3 - 2 = " + to_string(eval_expr("10 - 3 - 2")));
    print("42 = " + to_string(eval_expr("42")));
    print("3.5 * 2 = " + to_string(eval_expr("3.5 * 2")));
}
