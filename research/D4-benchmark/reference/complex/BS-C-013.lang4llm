// BS-C-013: Polynomial Arithmetic
// Polynomial as [float] where index = exponent coefficient.
// [3.0, 0.0, -1.0, 2.0] represents 3 - x^2 + 2x^3

fn poly_normalize(p: [float]) -> [float] {
    let mut res: [float] = [];
    let mut i: int = 0;
    while i < len(p) {
        push(res, p[i]);
        i = i + 1;
    }
    while len(res) > 1 and res[len(res) - 1] == 0.0 {
        pop(res);
    }
    return res;
}

fn poly_add(p: [float], q: [float]) -> [float] {
    let mut sz: int = len(p);
    if len(q) > sz { sz = len(q); };
    let mut res: [float] = [];
    let mut i: int = 0;
    while i < sz {
        let mut pv: float = 0.0;
        let mut qv: float = 0.0;
        if i < len(p) { pv = p[i]; };
        if i < len(q) { qv = q[i]; };
        push(res, pv + qv);
        i = i + 1;
    }
    return poly_normalize(res);
}

fn poly_subtract(p: [float], q: [float]) -> [float] {
    let mut sz: int = len(p);
    if len(q) > sz { sz = len(q); };
    let mut res: [float] = [];
    let mut i: int = 0;
    while i < sz {
        let mut pv: float = 0.0;
        let mut qv: float = 0.0;
        if i < len(p) { pv = p[i]; };
        if i < len(q) { qv = q[i]; };
        push(res, pv - qv);
        i = i + 1;
    }
    return poly_normalize(res);
}

fn poly_multiply(p: [float], q: [float]) -> [float] {
    let result_len: int = len(p) + len(q) - 1;
    let mut res: [float] = [];
    let mut k: int = 0;
    while k < result_len {
        push(res, 0.0);
        k = k + 1;
    }
    let mut i: int = 0;
    while i < len(p) {
        let mut j: int = 0;
        while j < len(q) {
            res[i + j] = res[i + j] + p[i] * q[j];
            j = j + 1;
        }
        i = i + 1;
    }
    return poly_normalize(res);
}

fn poly_evaluate(p: [float], x: float) -> float {
    // Horner's method: evaluate from highest to lowest
    let mut result: float = 0.0;
    let mut i: int = len(p) - 1;
    while i >= 0 {
        result = result * x + p[i];
        i = i - 1;
    }
    return result;
}

fn poly_derivative(p: [float]) -> [float] {
    if len(p) <= 1 {
        let mut z: [float] = [0.0];
        return z;
    };
    let mut res: [float] = [];
    let mut i: int = 1;
    while i < len(p) {
        push(res, as_float(i) * p[i]);
        i = i + 1;
    }
    return poly_normalize(res);
}

fn poly_to_string(p: [float]) -> string {
    let mut s: string = "[";
    let mut i: int = 0;
    while i < len(p) {
        if i > 0 { s = s + ", "; };
        s = s + to_string(p[i]);
        i = i + 1;
    }
    s = s + "]";
    return s;
}

fn main() -> unit {
    // Test 1: add equal degree
    let p1: [float] = [1.0, 2.0, 3.0];
    let q1: [float] = [4.0, 5.0, 6.0];
    print("add([1,2,3],[4,5,6]) = " + poly_to_string(poly_add(p1, q1)));

    // Test 2: add different degree
    let p2: [float] = [1.0, 2.0, 3.0];
    let q2: [float] = [0.0, -1.0, 0.0, 4.0];
    print("add([1,2,3],[0,-1,0,4]) = " + poly_to_string(poly_add(p2, q2)));

    // Test 3: subtract same -> zero
    let p3: [float] = [5.0, 3.0, 2.0];
    let q3: [float] = [5.0, 3.0, 2.0];
    print("sub same = " + poly_to_string(poly_subtract(p3, q3)));

    // Test 4: multiply (1+x)(1-x) = 1 - x^2
    let p4: [float] = [1.0, 1.0];
    let q4: [float] = [1.0, -1.0];
    print("mul([1,1],[1,-1]) = " + poly_to_string(poly_multiply(p4, q4)));

    // Test 5: multiply by zero poly
    let p5: [float] = [3.0, 2.0, 1.0];
    let q5: [float] = [0.0];
    print("mul by zero = " + poly_to_string(poly_multiply(p5, q5)));

    // Test 6: evaluate at x=3 for [2, 0, 1] = 2 + x^2 = 2+9=11
    let p6: [float] = [2.0, 0.0, 1.0];
    print("eval([2,0,1],3) = " + to_string(poly_evaluate(p6, 3.0)));

    // Test 7: evaluate at x=0
    print("eval([2,0,1],0) = " + to_string(poly_evaluate(p6, 0.0)));

    // Test 8: evaluate at x=-2 = 2+4=6
    print("eval([2,0,1],-2) = " + to_string(poly_evaluate(p6, -2.0)));

    // Test 9: derivative of [5, 3, 2, 1] = [3, 4, 3]
    let p9: [float] = [5.0, 3.0, 2.0, 1.0];
    print("deriv([5,3,2,1]) = " + poly_to_string(poly_derivative(p9)));

    // Test 10: derivative of constant
    let p10: [float] = [7.0];
    print("deriv([7]) = " + poly_to_string(poly_derivative(p10)));

    // Test 11: evaluate at x=1 for [1,2,3] = 1+2+3=6
    let p11: [float] = [1.0, 2.0, 3.0];
    print("eval([1,2,3],1) = " + to_string(poly_evaluate(p11, 1.0)));

    // Test 12: normalization - add [1,2,3] + [-1,-2,-3,4] should trail correctly
    let p12: [float] = [1.0, 2.0, 3.0];
    let q12: [float] = [-1.0, -2.0, -3.0, 4.0];
    print("add norm = " + poly_to_string(poly_add(p12, q12)));
}
