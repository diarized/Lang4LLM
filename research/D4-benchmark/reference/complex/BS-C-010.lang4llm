fn is_digit(c: string) -> bool {
    return c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
        or c == "5" or c == "6" or c == "7" or c == "8" or c == "9";
}

fn is_whitespace(c: string) -> bool {
    return c == " " or c == "\t";
}

fn tokenize(expr: string) -> [string] {
    let chs: [string] = chars(expr);
    let mut tokens: [string] = [];
    let mut i: int = 0;
    let mut last_type: string = "none";
    let mut had_error: bool = false;
    while i < len(chs) and not had_error {
        let c: string = chs[i];
        if is_whitespace(c) {
            i = i + 1;
        } else {
            if is_digit(c) {
                let mut num: string = "";
                let mut dot_count: int = 0;
                while i < len(chs) and (is_digit(chs[i]) or chs[i] == ".") {
                    if chs[i] == "." {
                        dot_count = dot_count + 1;
                        if dot_count > 1 {
                            push(tokens, "ERROR:multiple_dots");
                            had_error = true;
                            i = len(chs);
                        } else {
                            num = num + to_string(chs[i]);
                            i = i + 1;
                        };
                    } else {
                        num = num + to_string(chs[i]);
                        i = i + 1;
                    };
                }
                if not had_error {
                    if ends_with(num, ".") {
                        push(tokens, "ERROR:trailing_dot");
                        had_error = true;
                    } else {
                        push(tokens, "NUM:" + num);
                        last_type = "NUM";
                    };
                };
            } else {
                if c == "+" {
                    push(tokens, "PLUS");
                    last_type = "PLUS";
                    i = i + 1;
                } else {
                    if c == "-" {
                        if last_type == "NUM" or last_type == "RPAREN" {
                            push(tokens, "MINUS");
                            last_type = "MINUS";
                        } else {
                            push(tokens, "NEGATE");
                            last_type = "NEGATE";
                        };
                        i = i + 1;
                    } else {
                        if c == "*" {
                            push(tokens, "MUL");
                            last_type = "MUL";
                            i = i + 1;
                        } else {
                            if c == "/" {
                                push(tokens, "DIV");
                                last_type = "DIV";
                                i = i + 1;
                            } else {
                                if c == "(" {
                                    push(tokens, "LPAREN");
                                    last_type = "LPAREN";
                                    i = i + 1;
                                } else {
                                    if c == ")" {
                                        push(tokens, "RPAREN");
                                        last_type = "RPAREN";
                                        i = i + 1;
                                    } else {
                                        if c == "." {
                                            push(tokens, "ERROR:leading_dot");
                                            had_error = true;
                                            i = len(chs);
                                        } else {
                                            push(tokens, "ERROR:unknown_char");
                                            had_error = true;
                                            i = len(chs);
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    }
    return tokens;
}

fn print_tokens(expr: string) -> unit {
    let toks: [string] = tokenize(expr);
    let mut i: int = 0;
    while i < len(toks) {
        print(toks[i]);
        i = i + 1;
    }
}

fn main() -> unit {
    print("--- 3 + 4 * 2 ---");
    print_tokens("3 + 4 * 2");

    print("--- 3.14 * 2 ---");
    print_tokens("3.14 * 2");

    print("--- -3 + 5 - 2 ---");
    print_tokens("-3 + 5 - 2");

    print("--- (-3 + -4) ---");
    print_tokens("(-3 + -4)");

    print("--- ((1 + 2)) / 3 ---");
    print_tokens("((1 + 2)) / 3");

    print("--- empty ---");
    print_tokens("");

    print("--- 3 @ 4 ---");
    print_tokens("3 @ 4");

    print("--- 5 - -3 ---");
    print_tokens("5 - -3");
}
