fn knapsack(weights: [int], values: [int], cap: int) -> unit {
    let n: int = len(weights);
    let cols: int = cap + 1;
    let mut dp: [int] = [];
    let mut total: int = (n + 1) * cols;
    let mut k: int = 0;
    while k < total {
        push(dp, 0);
        k = k + 1;
    }
    let mut i: int = 1;
    while i <= n {
        let mut w: int = 0;
        while w <= cap {
            let prev: int = dp[(i - 1) * cols + w];
            if weights[i - 1] <= w {
                let with_item: int = dp[(i - 1) * cols + (w - weights[i - 1])] + values[i - 1];
                if with_item > prev {
                    dp[i * cols + w] = with_item;
                } else {
                    dp[i * cols + w] = prev;
                };
            } else {
                dp[i * cols + w] = prev;
            };
            w = w + 1;
        }
        i = i + 1;
    }
    let max_val: int = dp[n * cols + cap];
    let mut selected: [int] = [];
    let mut rem: int = cap;
    let mut ii: int = n;
    while ii > 0 {
        if dp[ii * cols + rem] != dp[(ii - 1) * cols + rem] {
            push(selected, ii - 1);
            rem = rem - weights[ii - 1];
        };
        ii = ii - 1;
    }
    reverse(selected);
    let mut sel_str: string = "[";
    let mut j: int = 0;
    while j < len(selected) {
        if j > 0 { sel_str = sel_str + ", "; };
        sel_str = sel_str + to_string(selected[j]);
        j = j + 1;
    }
    sel_str = sel_str + "]";
    print("max_value = " + to_string(max_val) + ", items = " + sel_str);
}

fn main() -> unit {
    let w1: [int] = [2, 2, 3];
    let v1: [int] = [6, 10, 12];
    knapsack(w1, v1, 5);

    let w2: [int] = [10, 20];
    let v2: [int] = [100, 200];
    knapsack(w2, v2, 5);

    let w3: [int] = [1, 2, 1];
    let v3: [int] = [5, 8, 3];
    knapsack(w3, v3, 10);

    let w4: [int] = [];
    let v4: [int] = [];
    knapsack(w4, v4, 100);

    let w5: [int] = [5];
    let v5: [int] = [100];
    knapsack(w5, v5, 0);

    let w6: [int] = [5];
    let v6: [int] = [100];
    knapsack(w6, v6, 5);

    let w7: [int] = [3, 4, 2, 1];
    let v7: [int] = [4, 5, 3, 1];
    knapsack(w7, v7, 6);
}
