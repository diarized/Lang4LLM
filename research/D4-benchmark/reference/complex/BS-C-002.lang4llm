fn dijkstra(n: int, efrom: [int], eto: [int], ewt: [int], src: int) -> [int] {
    let mut dist: [int] = [];
    let mut visited: [bool] = [];
    let mut i: int = 0;
    while i < n {
        push(dist, 999999);
        push(visited, false);
        i = i + 1;
    }
    dist[src] = 0;
    let mut itr: int = 0;
    while itr < n {
        let mut u: int = -1;
        let mut j: int = 0;
        while j < n {
            if not visited[j] {
                if u == -1 {
                    u = j;
                } else {
                    if dist[j] < dist[u] {
                        u = j;
                    };
                };
            };
            j = j + 1;
        }
        if u == -1 {
            itr = n;
        } else {
            visited[u] = true;
            let mut e: int = 0;
            while e < len(efrom) {
                if efrom[e] == u {
                    let v: int = eto[e];
                    let nd: int = dist[u] + ewt[e];
                    if nd < dist[v] {
                        dist[v] = nd;
                    };
                };
                e = e + 1;
            }
            itr = itr + 1;
        };
    }
    return dist;
}

fn print_dists(dist: [int], n: int) -> unit {
    let mut i: int = 0;
    while i < n {
        print("dist[" + to_string(i) + "] = " + to_string(dist[i]));
        i = i + 1;
    }
}

fn main() -> unit {
    print("--- Graph 1: simple connected ---");
    let ef1: [int] = [0, 0, 1, 1, 2];
    let et1: [int] = [1, 2, 2, 3, 3];
    let ew1: [int] = [1, 4, 2, 5, 1];
    let d1: [int] = dijkstra(4, ef1, et1, ew1, 0);
    print_dists(d1, 4);

    print("--- Graph 2: multiple paths ---");
    let ef2: [int] = [0, 0, 1, 2, 2];
    let et2: [int] = [1, 2, 3, 1, 3];
    let ew2: [int] = [5, 2, 1, 1, 5];
    let d2: [int] = dijkstra(4, ef2, et2, ew2, 0);
    print_dists(d2, 4);

    print("--- Graph 3: disconnected ---");
    let ef3: [int] = [0, 2];
    let et3: [int] = [1, 3];
    let ew3: [int] = [1, 1];
    let d3: [int] = dijkstra(4, ef3, et3, ew3, 0);
    print_dists(d3, 4);

    print("--- Graph 4: single node ---");
    let ef4: [int] = [];
    let et4: [int] = [];
    let ew4: [int] = [];
    let d4: [int] = dijkstra(1, ef4, et4, ew4, 0);
    print_dists(d4, 1);

    print("--- Graph 5: linear chain ---");
    let ef5: [int] = [0, 1, 2];
    let et5: [int] = [1, 2, 3];
    let ew5: [int] = [3, 2, 1];
    let d5: [int] = dijkstra(4, ef5, et5, ew5, 0);
    print_dists(d5, 4);
}
