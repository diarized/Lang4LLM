fn binary_search(nums: [int], target: int) -> int {
    let mut low: int = 0;
    let mut high: int = len(nums) - 1;
    while low <= high {
        let mid: int = low + (high - low) / 2;
        if nums[mid] == target {
            return mid;
        } else {
            if nums[mid] < target {
                low = mid + 1;
            } else {
                high = mid - 1;
            };
        };
    }
    return -1;
}

fn main() -> unit {
    let nums: [int] = [1, 3, 5, 7, 9, 11];
    print("search(7) = " + to_string(binary_search(nums, 7)));
    print("search(12) = " + to_string(binary_search(nums, 12)));
    print("search(1) = " + to_string(binary_search(nums, 1)));
    print("search(11) = " + to_string(binary_search(nums, 11)));
    print("search(0) = " + to_string(binary_search(nums, 0)));
    let empty: [int] = [];
    print("search_empty = " + to_string(binary_search(empty, 5)));
    let single: [int] = [5];
    print("search_single_found = " + to_string(binary_search(single, 5)));
    print("search_single_miss = " + to_string(binary_search(single, 3)));
    print("search(5) = " + to_string(binary_search(nums, 5)));
}
