fn combinations(n: int, k: int) -> int {
    if k > n {
        return 0;
    };
    if k == 0 or k == n {
        return 1;
    };
    let mut effective_k: int = k;
    if n - k < k {
        effective_k = n - k;
    };
    let mut result: int = 1;
    for i in range(1, effective_k + 1) {
        result = result * (n - i + 1);
        result = result / i;
    }
    return result;
}

fn main() -> unit {
    // Test 1: k = 0
    print("C(7, 0) = " + to_string(combinations(7, 0)));

    // Test 2: k = n
    print("C(4, 4) = " + to_string(combinations(4, 4)));

    // Test 3: k = 1
    print("C(8, 1) = " + to_string(combinations(8, 1)));

    // Test 4: k > n
    print("C(3, 5) = " + to_string(combinations(3, 5)));

    // Test 5: n = 0, k = 0
    print("C(0, 0) = " + to_string(combinations(0, 0)));

    // Test 6: standard C(5, 2) = 10
    print("C(5, 2) = " + to_string(combinations(5, 2)));

    // Test 7: standard C(10, 3) = 120
    print("C(10, 3) = " + to_string(combinations(10, 3)));

    // Test 8: symmetry C(6, 4) = C(6, 2) = 15
    print("C(6, 4) = " + to_string(combinations(6, 4)));
    print("C(6, 2) = " + to_string(combinations(6, 2)));

    // Test 9: boundary n = 30, k = 15
    print("C(30, 15) = " + to_string(combinations(30, 15)));
}
