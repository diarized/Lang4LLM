fn insertion_sort(nums: [int]) -> [int] {
    let n: int = len(nums);
    if n <= 1 {
        return nums;
    };
    let mut arr: [int] = nums;
    for i in range(1, n) {
        let key: int = arr[i];
        let mut j: int = i - 1;
        let mut insert_pos: int = 0;
        let mut found: bool = false;
        while j >= 0 {
            if arr[j] > key {
                arr[j + 1] = arr[j];
                j = j - 1;
            } else {
                insert_pos = j + 1;
                found = true;
                j = -1;
            };
        }
        if not found {
            insert_pos = 0;
        };
        arr[insert_pos] = key;
    }
    return arr;
}

fn arr_to_str(arr: [int]) -> string {
    if is_empty(arr) {
        return "[]";
    };
    let mut s: string = "[";
    for i in range(0, len(arr)) {
        if i > 0 {
            s = s + ", ";
        };
        s = s + to_string(arr[i]);
    }
    s = s + "]";
    return s;
}

fn main() -> unit {
    // Test 1: unsorted positive integers
    let t1: [int] = [5, 2, 8, 1, 9, 3];
    print("sort([5,2,8,1,9,3]) = " + arr_to_str(insertion_sort(t1)));

    // Test 2: already sorted
    let t2: [int] = [1, 2, 3, 4, 5];
    print("sort([1,2,3,4,5]) = " + arr_to_str(insertion_sort(t2)));

    // Test 3: reverse sorted (worst case)
    let t3: [int] = [5, 4, 3, 2, 1];
    print("sort([5,4,3,2,1]) = " + arr_to_str(insertion_sort(t3)));

    // Test 4: duplicates
    let t4: [int] = [3, 1, 4, 1, 5, 9, 2, 6, 5];
    print("sort([3,1,4,1,5,9,2,6,5]) = " + arr_to_str(insertion_sort(t4)));

    // Test 5: empty list
    let t5: [int] = [];
    print("sort([]) = " + arr_to_str(insertion_sort(t5)));

    // Test 6: single element
    let t6: [int] = [42];
    print("sort([42]) = " + arr_to_str(insertion_sort(t6)));

    // Test 7: negative integers
    let t7: [int] = [-3, 0, -1, 5, -7, 2];
    print("sort([-3,0,-1,5,-7,2]) = " + arr_to_str(insertion_sort(t7)));

    // Test 8: all identical values
    let t8: [int] = [4, 4, 4, 4];
    print("sort([4,4,4,4]) = " + arr_to_str(insertion_sort(t8)));

    // Test 9: two elements sorted
    let t9a: [int] = [1, 2];
    print("sort([1,2]) = " + arr_to_str(insertion_sort(t9a)));

    // Test 10: two elements reversed
    let t9b: [int] = [2, 1];
    print("sort([2,1]) = " + arr_to_str(insertion_sort(t9b)));
}
