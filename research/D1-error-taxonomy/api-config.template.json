{
  "models": {
    "gpt4": {
      "provider": "openai",
      "model_name": "gpt-4-turbo-preview",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.0,
      "max_tokens": 2048,
      "timeout": 60
    },
    "claude": {
      "provider": "anthropic",
      "model_name": "claude-3-5-sonnet-20241022",
      "api_key_env": "ANTHROPIC_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "timeout": 60
    },
    "deepseek": {
      "provider": "deepseek",
      "model_name": "deepseek-coder",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.0,
      "max_tokens": 2048,
      "timeout": 60
    }
  },
  "evaluation": {
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "batch_size": 10,
    "save_intermediate_results": true
  },
  "logging": {
    "level": "INFO",
    "log_file": "research/D1-error-taxonomy/data/evaluation.log"
  }
}
