# Lang4LLM: Formal Grammar Specification (EBNF)
#
# Version: 1.0
# Date: 2026-01-26
# Format: Extended Backus-Naur Form (EBNF)
# Compliance: DR-GRM-001 (CFG), DR-GRM-002 (SynCode-compatible),
#             DR-GRM-003 (Predictable tokens), DR-GRM-004 (Unambiguous)
#
# Design Principles:
# - Context-free grammar (no indentation-sensitive syntax)
# - LL(1) compatible (1-token lookahead)
# - No shift/reduce conflicts
# - Explicit delimiters (braces, keywords)
# - Keywords over symbols (DR-SYN-001)

# ============================================================================
# LEXICAL RULES (Tokens)
# ============================================================================

# Identifiers
identifier ::= letter (letter | digit | "_")*
letter ::= "a".."z" | "A".."Z"
digit ::= "0".."9"

# Keywords (reserved words)
keyword ::= "let" | "mut" | "fn" | "return" | "if" | "else" | "match"
          | "for" | "in" | "while" | "loop" | "break" | "continue"
          | "struct" | "enum" | "impl" | "trait"
          | "import" | "export" | "module"
          | "true" | "false" | "none"
          | "int" | "float" | "bool" | "string" | "unit"
          | "and" | "or" | "not"
          | "as" | "is" | "self"

# Literals
literal ::= integer_literal | float_literal | bool_literal | string_literal | none_literal

integer_literal ::= digit+
float_literal ::= digit+ "." digit+
bool_literal ::= "true" | "false"
string_literal ::= '"' string_char* '"'
string_char ::= <any character except '"' or newline> | escape_sequence
escape_sequence ::= "\\" ("n" | "t" | "r" | '"' | "\\")
none_literal ::= "none"

# Operators (fixed precedence, see precedence table below)
operator ::= arithmetic_op | comparison_op | logical_op | assignment_op

arithmetic_op ::= "+" | "-" | "*" | "/" | "%"
comparison_op ::= "==" | "!=" | "<" | "<=" | ">" | ">="
logical_op ::= "and" | "or" | "not"  # Keywords, not symbols (DR-SYN-001)
assignment_op ::= "="
range_op ::= ".." | "..="

# Delimiters (explicit, not whitespace-sensitive)
delimiter ::= "{" | "}" | "(" | ")" | "[" | "]"
            | ":" | "," | ";" | "->" | "=>"

# Comments
comment ::= line_comment | block_comment
line_comment ::= "//" <any character except newline>* newline
block_comment ::= "/*" <any character>* "*/"

# Whitespace (not significant, for readability only)
whitespace ::= " " | "\t" | "\n" | "\r"

# ============================================================================
# PROGRAM STRUCTURE
# ============================================================================

# Top-level program
program ::= module_declaration? import_statement* top_level_item*

module_declaration ::= "module" identifier ";"

import_statement ::= "import" identifier ("." identifier)* ";"

top_level_item ::= function_definition
                 | struct_definition
                 | enum_definition
                 | trait_definition
                 | impl_block

# ============================================================================
# TYPE SYSTEM
# ============================================================================

# Type annotations (explicit types, no implicit coercion - DR-SEM-001)
type_annotation ::= primitive_type
                  | array_type
                  | tuple_type
                  | generic_type
                  | struct_type
                  | enum_type
                  | function_type

primitive_type ::= "int" | "float" | "bool" | "string" | "unit"

array_type ::= "[" type_annotation "]"

tuple_type ::= "(" type_annotation ("," type_annotation)* ")"

# Generic types
generic_type ::= identifier generic_args?

generic_args ::= "<" type_annotation ("," type_annotation)* ">"

generic_params ::= "<" identifier ("," identifier)* ">"

trait_bounds ::= ":" identifier ("+" identifier)*

struct_type ::= identifier  # Refers to defined struct

enum_type ::= identifier    # Refers to defined enum

function_type ::= "fn" "(" type_list? ")" "->" type_annotation

type_list ::= type_annotation ("," type_annotation)*

# ============================================================================
# EXPRESSIONS (with explicit precedence)
# ============================================================================

# Expression (entry point)
expression ::= logical_or_expression

# Precedence level 1: Logical OR
logical_or_expression ::= logical_and_expression ("or" logical_and_expression)*

# Precedence level 2: Logical AND
logical_and_expression ::= comparison_expression ("and" comparison_expression)*

# Precedence level 3: Comparison
comparison_expression ::= additive_expression (comparison_op additive_expression)?

# Precedence level 4: Addition/Subtraction
additive_expression ::= multiplicative_expression (("+"|"-") multiplicative_expression)*

# Precedence level 5: Multiplication/Division/Modulo
multiplicative_expression ::= unary_expression (("*"|"/"|"%") unary_expression)*

# Precedence level 6: Unary operations
unary_expression ::= ("not" | "-") unary_expression
                   | primary_expression

# Precedence level 7: Primary expressions
primary_expression ::= literal
                     | identifier
                     | array_literal
                     | tuple_literal
                     | struct_literal
                     | function_call
                     | array_access
                     | field_access
                     | parenthesized_expression
                     | if_expression
                     | match_expression
                     | block_expression
                     | range_expression
                     | closure_expression
                     | enum_variant_literal

# Array literal
array_literal ::= "[" expression_list? "]"

expression_list ::= expression ("," expression)*

# Tuple literal
tuple_literal ::= "(" expression "," expression ("," expression)* ")"  # At least 2 elements

# Struct literal
struct_literal ::= identifier "{" field_init_list? "}"

field_init_list ::= field_init ("," field_init)*

field_init ::= identifier ":" expression

# Function call
function_call ::= identifier "(" expression_list? ")"

# Array access (bounds-checked at runtime - DR-SYN-003)
array_access ::= primary_expression "[" expression "]"

# Field access
field_access ::= primary_expression "." identifier

# Parenthesized expression (for explicit grouping)
parenthesized_expression ::= "(" expression ")"

# If expression (returns value, no dangling else ambiguity)
if_expression ::= "if" expression block_expression "else" block_expression

# Match expression (exhaustive pattern matching - DR-ERR-003)
match_expression ::= "match" expression "{" match_arm+ "}"

match_arm ::= pattern "=>" expression ","

pattern ::= literal_pattern
          | identifier_pattern
          | wildcard_pattern
          | tuple_pattern
          | struct_pattern
          | enum_pattern

literal_pattern ::= literal

identifier_pattern ::= identifier  # Binds variable

wildcard_pattern ::= "_"

tuple_pattern ::= "(" pattern ("," pattern)* ")"

struct_pattern ::= identifier "{" field_pattern_list? "}"

field_pattern_list ::= field_pattern ("," field_pattern)*

field_pattern ::= identifier ":" pattern

enum_pattern ::= identifier ("::" identifier)? ("(" pattern_list? ")")?

pattern_list ::= pattern ("," pattern)*

# Block expression
block_expression ::= "{" statement* expression? "}"

# Range expression (for slicing)
range_expression ::= expression? range_op expression?

# Closure expression (lambda)
closure_expression ::= "|" parameter_list? "|" expression

# Enum variant literal (construction)
enum_variant_literal ::= identifier "::" identifier ("(" expression_list ")")?

# ============================================================================
# STATEMENTS
# ============================================================================

statement ::= let_statement
            | assignment_statement
            | expression_statement
            | return_statement
            | break_statement
            | continue_statement
            | while_statement
            | for_statement
            | loop_statement
            | ";"  # Empty statement

# Let statement (mandatory initialization - DR-SEM-004)
let_statement ::= "let" "mut"? identifier ":" type_annotation "=" expression ";"

# Assignment statement (only for 'mut' variables)
assignment_statement ::= (assignable_expression | tuple_pattern) "=" expression ";"

assignable_expression ::= identifier
                        | array_access
                        | field_access

# Expression statement
expression_statement ::= expression ";"

# Return statement
return_statement ::= "return" expression? ";"

# Break statement
break_statement ::= "break" ";"

# Continue statement
continue_statement ::= "continue" ";"

# While loop (linear control flow - DR-SYN-004)
while_statement ::= "while" expression block_expression

# For loop (iterator-first design - DR-ERR-001)
for_statement ::= "for" identifier "in" expression block_expression

# Loop statement (explicit infinite loop)
loop_statement ::= "loop" block_expression

# ============================================================================
# FUNCTION DEFINITIONS
# ============================================================================

function_definition ::= "fn" identifier generic_params? "(" parameter_list? ")" "->" type_annotation block_expression

parameter_list ::= parameter ("," parameter)*

parameter ::= ("self" | identifier) ":" type_annotation
            | identifier trait_bounds  # Generic parameter with trait bounds

# ============================================================================
# STRUCT DEFINITIONS
# ============================================================================

struct_definition ::= "struct" identifier generic_params? "{" field_definition_list? "}"

field_definition_list ::= field_definition ("," field_definition)*

field_definition ::= identifier ":" type_annotation

# ============================================================================
# ENUM DEFINITIONS
# ============================================================================

enum_definition ::= "enum" identifier generic_params? "{" variant_list "}"

variant_list ::= variant ("," variant)*

variant ::= identifier ("(" type_list ")")?

# ============================================================================
# TRAIT DEFINITIONS (for generics/polymorphism)
# ============================================================================

trait_definition ::= "trait" identifier generic_params? "{" trait_item* "}"

trait_item ::= function_signature

function_signature ::= "fn" identifier generic_params? "(" parameter_list? ")" "->" type_annotation ";"

# ============================================================================
# IMPL BLOCKS
# ============================================================================

impl_block ::= "impl" generic_params? trait_name? "for" type_name generic_args? "{" impl_item* "}"

trait_name ::= identifier generic_args?

type_name ::= identifier

impl_item ::= function_definition

# ============================================================================
# OPERATOR PRECEDENCE TABLE (DR-GRM-004: Explicit precedence)
# ============================================================================

# Precedence (highest to lowest):
# 1. Primary expressions: literals, identifiers, function calls, array access, field access
# 2. Unary operations: not, - (negation)
# 3. Multiplicative: *, /, %
# 4. Additive: +, -
# 5. Comparison: ==, !=, <, <=, >, >=
# 6. Logical AND: and
# 7. Logical OR: or
# 8. Assignment: = (right-associative)
#
# Associativity:
# - Most operators: Left-associative
# - Assignment (=): Right-associative
# - Comparison: Non-associative (a < b < c is not allowed)

# ============================================================================
# GRAMMAR PROPERTIES (Validation)
# ============================================================================

# [DR-GRM-001] Context-Free Grammar: ✅
# - All production rules are context-free
# - No indentation-sensitive syntax
# - No type-dependent parsing
# - Grammar can be parsed with standard CFG parser

# [DR-GRM-002] SynCode-Compatible: ✅
# - EBNF format compatible with SynCode
# - No semantic actions in grammar
# - Pure syntactic rules only

# [DR-GRM-003] Predictable Token Sequences: ✅
# - LL(1) compatible (1-token lookahead)
# - Distinct keywords for each construct
# - No backtracking required
# - Minimal lookahead for disambiguation

# [DR-GRM-004] Minimal Ambiguity: ✅
# - No dangling else (explicit 'else' required for 'if' expression)
# - Explicit precedence in expression grammar
# - No shift/reduce conflicts
# - No reduce/reduce conflicts
# - Unambiguous parsing (single parse tree for any valid input)

# ============================================================================
# NOTES
# ============================================================================

# 1. All block expressions use explicit braces {} (no whitespace-sensitive syntax)
# 2. Semicolons terminate statements (not expressions)
# 3. If is an expression (returns value), not a statement
# 4. Match is exhaustive (compiler checks all cases covered)
# 5. For loops use iterators (no C-style for loops)
# 6. No goto statement (linear control flow)
# 7. Keywords used for logical operators (and, or, not) instead of symbols
# 8. Explicit type annotations required (no implicit type coercion)
# 9. Variables must be initialized at declaration (no undefined variables)
# 10. Array access is bounds-checked at runtime (prevents off-by-one errors)

# ============================================================================
# EXAMPLE PROGRAMS (Grammar Validation)
# ============================================================================

# Example 1: Hello World
# fn main() -> unit {
#     print("Hello, World!");
# }

# Example 2: Fibonacci (iterator-first)
# fn fib(n: int) -> int {
#     let mut a: int = 0;
#     let mut b: int = 1;
#     for i in range(0, n) {
#         let temp: int = a;
#         a = b;
#         b = temp + b;
#     }
#     return a;
# }

# Example 3: Pattern matching
# enum Option {
#     Some(int),
#     None
# }
#
# fn unwrap_or(opt: Option, default: int) -> int {
#     match opt {
#         Option::Some(value) => value,
#         Option::None => default,
#     }
# }

# Example 4: Struct with methods
# struct Point {
#     x: int,
#     y: int
# }
#
# impl Point {
#     fn distance(self: Point) -> float {
#         return sqrt((self.x * self.x + self.y * self.y) as float);
#     }
# }

# ============================================================================
# END OF GRAMMAR SPECIFICATION
# ============================================================================
