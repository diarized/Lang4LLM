// Example 11: Loop Control Flow
// Demonstrates: loop keyword, break, continue, while

enum Option<T> {
    Some(T),
    None
}

fn find_first_even(arr: [int]) -> Option<int> {
    for num in arr {
        if num % 2 == 0 {
            return Option::Some(num);
        } else {
            continue;
        }
    }

    return Option::None;
}

fn count_to_n(n: int) -> unit {
    let mut i: int = 0;

    while i < n {
        print("Count: " + i);
        i = i + 1;
    }

    return none;
}

fn main() -> unit {
    let numbers: [int] = [1, 3, 5, 8, 9];
    let first_even: Option<int> = find_first_even(numbers);

    let msg: string = match first_even {
        Option::Some(value) => "First even: " + value,
        Option::None => "No even numbers",
    };
    print(msg);

    count_to_n(5);
    return none;
}
