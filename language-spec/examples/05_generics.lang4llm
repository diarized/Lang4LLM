// Example 5: Generic Functions and Types
// Demonstrates: generic functions, generic structs, type parameters

fn identity<T>(x: T) -> T {
    return x;
}

fn swap<T>(a: T, b: T) -> (T, T) {
    return (b, a);
}

struct Pair<T, U> {
    first: T,
    second: U
}

impl<T, U> Pair<T, U> {
    fn new(first: T, second: U) -> Pair<T, U> {
        return Pair { first: first, second: second };
    }

    fn get_first(self: Pair<T, U>) -> T {
        return self.first;
    }
}

fn main() -> unit {
    let x: int = identity(42);
    let y: string = identity("hello");

    let pair: Pair<int, string> = Pair::new(100, "value");
    let first: int = pair.get_first();

    print("First: " + first);
    return none;
}
